# Copy to .env.local (or export in your shell) for local development.
# Only server/config/config.go reads these.

# --- API server ---
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=traackly
# Required, 32+ characters. Use a long random value in every real environment.
JWT_SECRET=change-me-to-a-long-random-string-32chars+
# Base URL used in invite/reset/kiosk links (the Vite dev server in local dev).
APP_BASE_URL=http://localhost:5173
# Must be true anywhere served over HTTPS. Set false only for plain-http local dev.
COOKIE_SECURE=false
# Serve the built client from the API (production). Leave empty when using the Vite dev server.
STATIC_DIR=
# Email: without RESEND_API_KEY, emails are written to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Traackly <notifications@yourdomain.com>
# Returns invite/reset links in API responses so they can be shown in the UI. Never in production.
EXPOSE_DEV_LINKS=true
LOG_LEVEL=INFO

# --- Seed command (go run ./cmd/seed [-demo]) ---
SEED_AUTHORIZER_NAME=Founder's Office
SEED_AUTHORIZER_EMAIL=founder@traackly.demo
SEED_AUTHORIZER_PASSWORD=traackly123

# --- Tests ---
# Integration tests need a MongoDB started with: --setParameter enableTestCommands=1
TRAACKLY_TEST_MONGODB_URI=mongodb://127.0.0.1:27017
